# =========================================================
# ARCA BACKEND - Example environment file
# Copy to .env and fill in your local values.
# =========================================================

APP_NAME=arca
APP_ENV=development
SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=arca_db
DB_USERNAME=arca_user
DB_PASSWORD=your_db_password
DB_URL=jdbc:postgresql://localhost:5432/arca_db

SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/arca_db
SPRING_DATASOURCE_USERNAME=arca_user
SPRING_DATASOURCE_PASSWORD=your_db_password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=arca-backend

CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:3000

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=no-reply@arca.local

LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
